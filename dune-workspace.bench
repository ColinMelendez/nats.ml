(lang dune 3.24)
(pkg enabled)

(pin
 (name thumper)
 (url
  "git+https://github.com/invariant-hq/thumper.git#0d42dc6964e30525b0595b6d5be04a1eda76c90e")
 (package
  (name thumper)))

(lock_dir
 (path dune.bench.lock)
 (pins thumper)
 (solver_env
  (sys-ocaml-version 5.5.0)
  (dev true))
 (constraints
  ocaml-system
  (ocaml (= 5.5.0))))

(context
 (default
  (lock_dir dune.bench.lock)))
