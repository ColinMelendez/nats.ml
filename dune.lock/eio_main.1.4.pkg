(version 1.4)

(build
 (all_platforms
  ((action (run dune build -p %{pkg-self:name} -j %{jobs} @install)))))

(depends
 (choice
  ((((arch x86_64)
     (os linux))
    ((arch arm64)
     (os linux)))
   (dune eio_linux eio_posix))
  ((((arch x86_64)
     (os macos))
    ((arch arm64)
     (os macos)))
   (dune eio_posix))))

(source
 (fetch
  (url
   https://github.com/ocaml-multicore/eio/releases/download/v1.4/eio-1.4.tbz)
  (checksum
   sha512=57ef2c137ccdc26d8029e636b6a4ee92da7c6b2f35954946bd56ca595d6947a8ec42f6f83f8552f73d6719e6ce2314cae2e2fad1686a387522935e6f90e9a8d9)))
